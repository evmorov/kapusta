(module Digits <<
  (fn sum [n]
    (var total 0)
    (var x n)
    (while (> x 0)
      (set total (+ total (% x 10)))
      (set x (/ x 10)))
    total)

  (fn reverse [n]
    (var result 0)
    (var x n)
    (while (> x 0)
      (set result (+ (* result 10) (% x 10)))
      (set x (/ x 10)))
    result)

  (fn palindrome? [n]
    (= n (Digits.reverse n))))

(print (Digits.sum 12345))
(print (Digits.reverse 1230))
(print (Digits.palindrome? 121))
(print (Digits.palindrome? 123))
