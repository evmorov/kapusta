(fn same-list? [a b]
  (var ok (= (length a) (length b)))
  (each [i value (ipairs a)]
    (when (not (= value (. b i)))
      (set ok false)))
  ok)

(fn abs [n]
  (if (< n 0) (- n) n))

(fn left-right-difference [nums]
  (let [total (accumulate [sum 0 _ n (ipairs nums)] (+ sum n))]
    (var left 0)
    (icollect [_ n (ipairs nums)]
      (do
        (let [right (- total left n)
              diff (abs (- left right))]
          (set left (+ left n))
          diff)))))

(print (same-list? [209
                    206
                    201
                    194
                    185
                    174
